# Maven build output
target/

# YOUR PERSONAL CONFIG — contains API keys and home address — NEVER commit this
config.properties

# Saved Assignr login session (cookies) — as sensitive as your password
.assignr-session.json
# Your Assignr payment history (cached statements) — personal financial data
pay-history.json

# IDE project files
.idea/
*.iml
.vscode/
*.DS_Store

# Compiled class files
*.class

# Debug files generated at runtime
debug-*.png
debug-*.html
debug-api-response-*.json
assignr-*.html

# Python RAG assistant: virtualenv, caches, and the generated vector index (rebuild with ingest.py)
rag/.venv/
rag/index/
# Rule documents stay local (rulebooks are usually copyrighted); keep the folder READMEs and .gitkeep files
rag/docs/**/*.pdf
rag/docs/**/*.txt
rag/docs/**/*.md
!rag/docs/README.md
# ...but our own quick-reference summaries are fine to commit
!rag/docs/leagues/*/_quick-reference-*.md
__pycache__/

# Scraped assignments exported for the Python RAG assistant — contains venue addresses
assignments.json
